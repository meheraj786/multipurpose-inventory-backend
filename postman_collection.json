          "request": {
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"password123\",\n  \"companyName\": \"My Awesome Company\",\n  \"category\": \"Retail\",\n  \"type\": \"Supermarket\",\n  \"model\": \"RETAIL\",\n  \"currency\": \"USD\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/v1/auth/register"
