generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==================== AUTH ====================

model User {
  id          String       @id @default(uuid())
  accountId   String?
  account     Account?     @relation(fields: [accountId], references: [id])
  email       String       @unique
  password    String
  role        UserRole     @default(STAFF)
  isDeleted   Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  permissions Permission[]

  @@index([accountId])
  @@index([email])
}

model Account {
  id               String       @id @default(uuid())
  companyName      String
  category         String
  type             String
  model            AccountModel
  logo             String?
  pricingPlanId    String?
  pricingPlan      PricingPlan? @relation(fields: [pricingPlanId], references: [id])
  saleIdPrefix     String?
  footerNotes      String?
  digitalSignature String?
  subsDate         DateTime?
  subsExpiryDate   DateTime?
  currency         Currency     @default(USD)
  status           AccountStatus @default(ACTIVE)
  isDeleted        Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  users            User[]

  @@index([pricingPlanId])
}

model Permission {
  id        String         @id @default(uuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id])
  accountId String
  module    SystemModule
  actions   SystemAction[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([userId, module])
  @@index([accountId])
  @@index([userId])
}

// ==================== SYSTEM ====================

model PricingPlan {
  id             String         @id @default(uuid())
  name           String         @unique
  description    String?
  monthlyPrice   Decimal
  yearlyPrice    Decimal
  features       String[]
  allowedModules SystemModule[]
  userLimit      Int?           // null = unlimited
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  accounts       Account[]

  @@index([isActive])
}

// ==================== CORE ====================

model Category {
  id            String        @id @default(uuid())
  name          String
  description   String?
  accountId     String
  isDeleted     Boolean       @default(false)
  subCategories SubCategory[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([accountId])
}

model SubCategory {
  id          String   @id @default(uuid())
  name        String
  description String?
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  accountId   String
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([accountId])
  @@index([categoryId])
}

model Customer {
  id            String   @id @default(uuid())
  name          String
  email         String?
  phone         String
  address       String?
  hasMembership Boolean  @default(false)
  isDeleted     Boolean  @default(false)
  accountId     String
  sales         Sale[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([accountId])
  @@index([name])
  @@index([phone])
}

model Sale {
  id             String        @id @default(uuid())
  productIds     String[]
  customerId     String?
  customer       Customer?     @relation(fields: [customerId], references: [id])
  customerNumber String?
  quantity       Int
  paymentMethod  PaymentMethod
  serviceId      String?
  purchasePrice  Decimal
  sellPrice      Decimal
  featureNames   FeatureName[]
  discount       Decimal?
  due            Decimal?
  invoices       Invoice[]
  isDeleted      Boolean       @default(false)
  accountId      String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([accountId])
  @@index([customerId])
}

model Invoice {
  id          String        @id @default(uuid())
  billTo      String
  invoiceDate DateTime
  saleId      String
  sale        Sale          @relation(fields: [saleId], references: [id])
  status      InvoiceStatus @default(PENDING)
  grandTotal  Decimal
  accountId   String
  isDeleted   Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([accountId])
  @@index([saleId])
}

model Trash {
  id         String       @id @default(uuid())
  moduleName SystemModule
  itemName   String
  itemId     String
  deletedBy  String
  accountId  String
  date       DateTime     @default(now())

  @@index([accountId])
}

model ActivityLog {
  id        String       @id @default(uuid())
  userId    String
  module    SystemModule
  action    SystemAction
  details   String?
  accountId String
  dateTime  DateTime     @default(now())

  @@index([accountId])
}

// ==================== ENUMS ====================

enum UserRole {
  DEVELOPER
  ADMIN
  STAFF
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum AccountModel {
  RETAIL
  SERVICE
  RESTAURANT
}

enum Currency {
  USD
  BDT
  EUR
  GBP
}

enum SystemModule {
  AUTH
  USER
  ACCOUNT
  CATEGORY
  SUBCATEGORY
  PRODUCT
  SUPPLIER
  CUSTOMER
  SALE
  PURCHASE
  INVENTORY
  WASTE
  TRASH
  ACTIVITY_LOG
  INVOICE
  PERMISSION
  PRICING_PLAN
}

enum SystemAction {
  CREATE
  READ
  UPDATE
  DELETE
  RESTORE
  LOGIN
  LOGOUT
  STOCK_IN
  STOCK_OUT
}

enum FeatureName {
  RETAIL
  SERVICE
  RESTAURANT
}

enum PaymentMethod {
  CASH
  CARD
  MOBILE_BANKING
  CREDIT
}

enum InvoiceStatus {
  PENDING
  PAID
  PARTIALLY_PAID
  CANCELLED
}