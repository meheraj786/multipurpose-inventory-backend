model Sale {
  id                String           @id @default(uuid())
  customerId        String?
  customer          Customer?        @relation(fields: [customerId], references: [id])
  customerNumber    String?
  paymentMethod     PaymentMethod    @default(CASH)
  payments          Json?
  discount          Decimal?         @default(0)
  due               Decimal?         @default(0)
  isDeleted         Boolean          @default(false)
  accountId         String
  account           Account          @relation(fields: [accountId], references: [id])
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  preparedProductId String?
  preparedProduct   PreparedProduct? @relation(fields: [preparedProductId], references: [id])

  saleItems    SaleItem[]
  saleServices SaleService[]
  invoices     Invoice[]
  customerReturns      CustomerReturn[]

  @@index([accountId])
  @@index([customerId])
  @@index([createdAt])
}

model SaleItem {
  id     String @id @default(uuid())
  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  itemType SaleItemType @default(PRODUCT)

  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  preparedProductId String?
  preparedProduct   PreparedProduct? @relation(fields: [preparedProductId], references: [id])

  unitId        String
  unit          Unit     @relation(fields: [unitId], references: [id])
  quantity      Decimal
  convertedQty  Decimal
  purchasePrice Decimal
  sellPrice     Decimal
  discount      Decimal? @default(0)
  accountId     String
  account       Account  @relation(fields: [accountId], references: [id])
  createdAt     DateTime @default(now())

  @@index([saleId])
  @@index([productId])
  @@index([preparedProductId])
  @@index([accountId])
}

model SaleService {
  id        String   @id @default(uuid())
  saleId    String
  serviceId String
  accountId String
  quantity  Int      @default(1)
  unitPrice Decimal
  discount  Decimal? @default(0)
  total     Decimal

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  account Account @relation(fields: [accountId], references: [id])

  @@unique([saleId, serviceId])
  @@index([accountId])
  @@index([saleId])
  @@index([serviceId])
}

// ==================== WASTAGE ====================

model Wastage {
  id                String           @id @default(uuid())
  productId         String?
  product           Product?         @relation(fields: [productId], references: [id])
  rawProductId      String?
  rawProduct        RawProduct?      @relation(fields: [rawProductId], references: [id])
  preparedProductId String?
  preparedProduct   PreparedProduct? @relation(fields: [preparedProductId], references: [id])
  quantity          Decimal
  reason            String
  notes             String?
  isDeleted         Boolean          @default(false)
  accountId         String
  account           Account          @relation(fields: [accountId], references: [id])
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([accountId])
  @@index([productId])
  @@index([rawProductId])
  @@index([preparedProductId])
}

model CustomerReturn {
  id                   String           @id @default(uuid())
  saleId               String
  sale                 Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  itemType             SaleItemType     @default(PRODUCT)
  productId            String?
  product              Product?         @relation(fields: [productId], references: [id])
  preparedProductId    String?
  preparedProduct      PreparedProduct? @relation(fields: [preparedProductId], references: [id])
  quantity             Decimal
  refundAmount         Decimal          @default(0)
  excessRefundAmount   Decimal          @default(0)
  requiresManualRefund Boolean          @default(false)
  restocked            Boolean          @default(true)
  reason               String?
  isDeleted            Boolean          @default(false)
  accountId            String
  account              Account          @relation(fields: [accountId], references: [id])
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([accountId])
  @@index([saleId])
  @@index([productId])
  @@index([preparedProductId])
}

// ==================== INVOICE ====================

model Invoice {
  id          String        @id @default(uuid())
  billTo      String
  invoiceDate DateTime
  saleId      String
  sale        Sale          @relation(fields: [saleId], references: [id])
  status      InvoiceStatus @default(PENDING)
  grandTotal  Decimal
  accountId   String
  account     Account       @relation(fields: [accountId], references: [id])
  isDeleted   Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([accountId])
  @@index([saleId])
}

// ==================== UTILITY ====================

model Trash {
  id         String       @id @default(uuid())
  moduleName SystemModule
  itemName   String
  itemId     String
  deletedBy  String
  accountId  String
  account    Account      @relation(fields: [accountId], references: [id])
  date       DateTime     @default(now())

  @@index([accountId])
}

model ActivityLog {
  id        String       @id @default(uuid())
  userId    String
  module    SystemModule
  action    SystemAction
  details   String?
  accountId String
  account   Account      @relation(fields: [accountId], references: [id])
  user      User         @relation(fields: [userId], references: [id])
  dateTime  DateTime     @default(now())

  @@index([accountId])
  @@index([userId])
}

model Notification {
  id        String   @id @default(uuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id])
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([accountId])
}

// ==================== ENUMS ====================

enum UnitGroup {
  WEIGHT
  VOLUME
  LENGTH
  COUNT
  AREA
}

enum UserRole {
  DEVELOPER
  ADMIN
  STAFF
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum AccountModel {
  RETAIL
  SERVICE
  RESTAURANT
  RETAIL_AND_SERVICE
  SERVICE_AND_RESTAURANT
  RETAIL_AND_RESTAURANT
  RETAIL_AND_SERVICE_AND_RESTAURANT
}

enum Currency {
  USD
  BDT
  EUR
  GBP
}

enum SystemModule {
  AUTH
  USER
  ACCOUNT
  CATEGORY
  SUBCATEGORY
  SUPPLIER
  PRODUCT
  RAW_PRODUCT
  PREPARED_PRODUCT
  PURCHASE
  SERVICE
  CUSTOMER
  SALE
  WASTAGE
  INVOICE
  PERMISSION
  PRICING_PLAN
  NOTIFICATION
  ACTIVITY_LOG
  TRASH
  STOCK
  STAFF
}

enum SystemAction {
  CREATE
  READ
  UPDATE
  DELETE
  RESTORE
  LOGIN
  LOGOUT
  STOCK_IN
  STOCK_OUT
}

enum FeatureName {
  RETAIL
  SERVICE
  RESTAURANT
}

enum PaymentMethod {
  CASH
  CARD
  MOBILE_BANKING
  CREDIT
  CASH_AND_CARD
  CASH_AND_MOBILE_BANKING
  CASH_AND_CREDIT
  CARD_AND_MOBILE_BANKING
  CARD_AND_CREDIT
  MOBILE_BANKING_AND_CREDIT
}

enum InvoiceStatus {
  PENDING
  PAID
  PARTIALLY_PAID
  CANCELLED
}

enum SaleItemType {
  PRODUCT
  PREPARED_PRODUCT
}

enum PurchasePaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}
