generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id    Int     @id @default(autoincrement())
  email String  @unique
  name  String?
}

model Category {
  id            String        @id @default(uuid())
  name          String
  description   String?
  accountId     String
  isDeleted     Boolean       @default(false)
  subCategories SubCategory[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([accountId])
}

model SubCategory {
  id          String   @id @default(uuid())
  name        String
  description String?
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  accountId   String
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([accountId])
  @@index([categoryId])
}

model Trash {
  id         String       @id @default(uuid())
  moduleName SystemModule
  itemName   String
  itemId     String
  deletedBy  String
  accountId  String
  date       DateTime     @default(now())

  @@index([accountId])
}

model ActivityLog {
  id        String       @id @default(uuid())
  userId    String
  module    SystemModule
  action    SystemAction
  details   String?
  accountId String
  dateTime  DateTime     @default(now())

  @@index([accountId])
}

model Customer {
  id            String   @id @default(uuid())
  name          String
  email         String?
  phone         String
  address       String?
  hasMembership Boolean  @default(false)
  isDeleted     Boolean  @default(false)
  accountId     String
  sales         Sale[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([accountId])
  @@index([name])
  @@index([phone])
}

model Sale {
  id             String        @id @default(uuid())
  productIds     String[]
  customerId     String?
  customer       Customer?     @relation(fields: [customerId], references: [id])
  customerNumber String?
  quantity       Int
  paymentMethod  PaymentMethod
  serviceId      String?
  purchasePrice  Decimal
  sellPrice      Decimal
  featureNames   FeatureName[]
  discount       Decimal?
  due            Decimal?
  invoices       Invoice[]
  isDeleted      Boolean       @default(false)
  accountId      String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([accountId])
  @@index([customerId])
}

model Invoice {
  id          String        @id @default(uuid())
  billTo      String
  invoiceDate DateTime
  saleId      String
  sale        Sale          @relation(fields: [saleId], references: [id])
  status      InvoiceStatus @default(PENDING)
  grandTotal  Decimal
  accountId   String
  isDeleted   Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([accountId])
  @@index([saleId])
}

enum SystemModule {
  AUTH
  USER
  CATEGORY
  SUBCATEGORY
  PRODUCT
  SUPPLIER
  CUSTOMER
  SALE
  PURCHASE
  INVENTORY
  WASTE
  TRASH
  ACTIVITY_LOG
  INVOICE
}

enum SystemAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  LOGIN
  LOGOUT
  STOCK_IN
  STOCK_OUT
}

enum FeatureName {
  RETAIL
  SERVICE
  RESTAURANT
}

enum PaymentMethod {
  CASH
  CARD
  MOBILE_BANKING
  CREDIT
}

enum InvoiceStatus {
  PENDING
  PAID
  PARTIALLY_PAID
  CANCELLED
}
