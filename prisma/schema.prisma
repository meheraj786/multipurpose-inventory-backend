generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// ==================== AUTH & ACCOUNT ====================

model User {
  id          String       @id @default(uuid())
  accountId   String
  account     Account      @relation(fields: [accountId], references: [id])
  email       String       @unique
  password    String
  role        UserRole     @default(STAFF)
  isDeleted   Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  permissions Permission[]

  @@index([accountId])
  @@index([email])
}

model Account {
  id               String        @id @default(uuid())
  companyName      String
  category         String
  type             String
  model            AccountModel
  logo             String?
  pricingPlanId    String?
  pricingPlan      PricingPlan?  @relation(fields: [pricingPlanId], references: [id])
  saleIdPrefix     String?
  footerNotes      String?
  digitalSignature String?
  subsDate         DateTime?
  subsExpiryDate   DateTime?
  currency         Currency      @default(USD)
  status           AccountStatus @default(ACTIVE)

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  users         User[]
  categories    Category[]
  subCategories SubCategory[]
  services      Service[]
  customers     Customer[]
  sales         Sale[]
  invoices      Invoice[]
  saleServices  SaleService[]
  trashes       Trash[]
  activityLogs  ActivityLog[]

  @@index([pricingPlanId])
  @@index([status])
}

// ==================== PERMISSION ====================

model Permission {
  id        String         @id @default(uuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id])
  accountId String
  module    SystemModule
  actions   SystemAction[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([userId, module])
  @@index([accountId])
}

// ==================== BILLING ====================

model PricingPlan {
  id             String         @id @default(uuid())
  name           String         @unique
  description    String?
  monthlyPrice   Decimal
  yearlyPrice    Decimal
  features       String[]
  allowedModules SystemModule[]
  userLimit      Int?
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  accounts Account[]

  @@index([isActive])
}

// ==================== CORE ====================

model Category {
  id          String  @id @default(uuid())
  name        String
  description String?
  accountId   String
  account     Account @relation(fields: [accountId], references: [id])

  subCategories SubCategory[]
  services      Service[]

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId])
}

model SubCategory {
  id          String   @id @default(uuid())
  name        String
  description String?
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id])

  services Service[]

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId])
  @@index([categoryId])
}

model Customer {
  id            String  @id @default(uuid())
  name          String
  email         String?
  phone         String
  address       String?
  hasMembership Boolean @default(false)
  isDeleted     Boolean @default(false)
  accountId     String
  account       Account @relation(fields: [accountId], references: [id])

  sales Sale[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId])
  @@index([phone])
  @@index([name])
}

model Service {
  id           String   @id @default(uuid())
  name         String
  internalCost Decimal? @default(0)
  salePrice    Decimal  @default(0)
  description  String?

  categoryId    String
  category      Category     @relation(fields: [categoryId], references: [id])
  subCategoryId String?
  subCategory   SubCategory? @relation(fields: [subCategoryId], references: [id])

  accountId String
  account   Account @relation(fields: [accountId], references: [id])

  saleServices SaleService[]

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId])
  @@index([categoryId])
  @@index([name])
}

// ==================== SALE & JUNCTION ====================

model Sale {
  id             String        @id @default(uuid())
  productIds     String[]
  customerId     String?
  customer       Customer?     @relation(fields: [customerId], references: [id])
  customerNumber String?
  paymentMethod  PaymentMethod
  purchasePrice  Decimal
  sellPrice      Decimal
  featureNames   FeatureName[]
  discount       Decimal?
  due            Decimal?

  accountId String
  account   Account @relation(fields: [accountId], references: [id])

  saleServices SaleService[]
  invoices     Invoice[]

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId])
  @@index([customerId])
  @@index([createdAt])
}

model SaleService {
  id String @id @default(uuid())

  saleId    String
  serviceId String
  accountId String

  quantity  Int      @default(1)
  unitPrice Decimal
  discount  Decimal? @default(0)
  total     Decimal

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  account Account @relation(fields: [accountId], references: [id])

  @@unique([saleId, serviceId])
  @@index([accountId])
  @@index([saleId])
  @@index([serviceId])
}

model Invoice {
  id          String        @id @default(uuid())
  billTo      String
  invoiceDate DateTime
  saleId      String
  sale        Sale          @relation(fields: [saleId], references: [id])
  status      InvoiceStatus @default(PENDING)
  grandTotal  Decimal
  accountId   String
  account     Account       @relation(fields: [accountId], references: [id])

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId])
  @@index([saleId])
}

// ==================== UTILITY ====================

model Trash {
  id         String       @id @default(uuid())
  moduleName SystemModule
  itemName   String
  itemId     String
  deletedBy  String
  accountId  String
  account    Account      @relation(fields: [accountId], references: [id])
  date       DateTime     @default(now())

  @@index([accountId])
}

model ActivityLog {
  id        String       @id @default(uuid())
  userId    String
  module    SystemModule
  action    SystemAction
  details   String?
  accountId String
  account   Account      @relation(fields: [accountId], references: [id])
  dateTime  DateTime     @default(now())

  @@index([accountId])
}

// ==================== ENUMS ====================

enum UserRole {
  DEVELOPER
  ADMIN
  STAFF
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum AccountModel {
  RETAIL
  SERVICE
  RESTAURANT
}

enum Currency {
  USD
  BDT
  EUR
  GBP
}

enum SystemModule {
  AUTH
  USER
  ACCOUNT
  CATEGORY
  SUBCATEGORY
  SERVICE
  CUSTOMER
  SALE
  INVOICE
  PERMISSION
  PRICING_PLAN
  // Add more as needed
}

enum SystemAction {
  CREATE
  READ
  UPDATE
  DELETE
  RESTORE
  LOGIN
  LOGOUT
}

enum FeatureName {
  RETAIL
  SERVICE
  RESTAURANT
}

enum PaymentMethod {
  CASH
  CARD
  MOBILE_BANKING
  CREDIT
}

enum InvoiceStatus {
  PENDING
  PAID
  PARTIALLY_PAID
  CANCELLED
}
