{
  "name": "mp-inventory",
  "version": "1.0.0",
  "description": "Multipurpose Inventory & Service Management System",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "tsx --watch --env-file=.env ./src/server.ts",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:staged": "biome check --staged --error-on-warnings --no-errors-on-unmatched",
    "format": "biome format --write .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "prepare": "prisma generate",
    "postinstall": "prisma generate",
    "build": "prisma generate && tsc && npx tsc-alias && ls -la dist",
    "start": "node --loader tsx ./src/server.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "keywords": [
    "inventory",
    "pos",
    "saas",
    "multi-tenant",
    "ddd"
  ],
  "author": "",
  "license": "UNLICENSED",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@types/http-status": "^1.1.2",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.4.1",
    "helmet": "^8.1.0",
    "http-status": "^2.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.16.0",
    "@types/pg": "^8.20.0",
    "husky": "^9.1.7",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.8.0",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
